# Copy this file to a new file named .env (in this same folder) and paste your key below.
# .env is private: git ignores it, so it is never uploaded to GitHub, and the game only
# reads it on your own computer. Never share the key or paste it into a chat.
ANTHROPIC_API_KEY=

# Optional: which Claude model plays the castaways. Leave blank for the default (claude-opus-5-5).
# A cheaper model such as claude-sonnet-5-5 or claude-haiku-5-5 costs less per season.
TIDECALL_MODEL=
